# 运行时数据：记录的是这台机器改动前的真实系统状态，属于用户私有数据，不进仓库
backup/
profiles/
config/
logs/

# 第三方工具由用户自行下载放入（体积大且各有授权条款），仓库只保留 .nip 配置档
tools/*.exe
tools/*.dll
!tools/PresentMon.exe
!tools/PresentMon-LICENSE.txt

# 打包产物
build/out/
build/*.exe
build/*.zip
# 根目录启动器 exe 由 build\make-launcher.ps1 现场编译，不进仓库
启动优化工具.exe

# 编辑器与系统
.vs/
.idea/
*.user
Thumbs.db
desktop.ini
__pycache__/
*.pyc

# 私有周报工作台只部署到受 Basic Auth 保护的服务器，不公开到 GitHub。
website/admin/
