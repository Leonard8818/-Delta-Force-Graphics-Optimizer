# 运行时数据：记录的是这台机器改动前的真实系统状态，属于用户私有数据，不进仓库
backup/
profiles/
config/
logs/

# 第三方二进制默认不进仓库；发布所需且已在构建脚本固定 SHA256 的组件逐项放行。
tools/*.exe
tools/*.dll
!tools/PresentMon.exe
!tools/PresentMon-LICENSE.txt
!tools/PawnIO_setup.exe
!tools/LibreHardwareMonitorLib.dll
!tools/HidSharp.dll
!tools/DiskInfoToolkit.dll
!tools/RAMSPDToolkit-NDD.dll
!tools/BlackSharp.Core.dll
!tools/System.Memory.dll
!tools/System.Runtime.CompilerServices.Unsafe.dll
!tools/System.Buffers.dll
!tools/System.Numerics.Vectors.dll

# 打包产物
build/out/
build/*.exe
build/*.zip
# 根目录启动器 exe 由 build\make-launcher.ps1 现场编译，不进仓库
启动优化工具.exe
# 管理员会话宿主由 build\make-engine-host.ps1 现场编译，不进仓库
EngineHost.exe

# 编辑器与系统
.vs/
.idea/
*.user
Thumbs.db
desktop.ini
__pycache__/
*.pyc

# 私有运营与部署源码不属于开源桌面软件仓库，仅保留在本地部署工作区。
/AGENTS.md
/server/
/website/
/tests/admin-dashboard-navigation-tests.ps1
/tests/admin-experiment-dashboard-tests.ps1
/tests/website-responsive-tests.ps1
